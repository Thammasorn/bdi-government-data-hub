# Copy to .env and adjust. `.env` is gitignored.
# docker compose reads this file automatically.

# ---------- Identity ----------
# Namespaces containers, networks and volumes. MUST be unique per checkout so
# several developers can run their stacks at the same time on one machine.
COMPOSE_PROJECT_NAME=bdi-main

# ---------- Ports ----------
# Every port must be unique per checkout too. Convention on the shared box:
#   main      3001 / 4000 / 5432 / 9000 / 9001
#   dev_NN    31N0 / 41N0 / 55N0 / 91N0 / 91N1     (dev_01 -> 3110, 4110, ...)
# `new-dev.sh` fills these in automatically.

# ---------- Postgres ----------
POSTGRES_USER=bdi
POSTGRES_PASSWORD=bdi_dev_password
POSTGRES_DB=bdi
POSTGRES_PORT=5432

# ---------- MinIO ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=bdi-uploads

# ตัวแปลง .docx -> PDF ของเอกสารกฎหมาย (บริการ gotenberg ใน compose)
# ปล่อยว่างไว้ได้ในเครื่อง dev — ค่าตั้งต้นชี้ไปที่บริการใน compose network
GOTENBERG_URL=
GOTENBERG_TIMEOUT_MS=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- Backend ----------
BACKEND_PORT=4000
NODE_ENV=development

# ---------- Frontend ----------
FRONTEND_PORT=3000
# URL the browser uses to reach the backend (host network, not compose network).
# Must match BACKEND_PORT.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------- Auth ----------
# session ไม่ใช่ JWT แล้ว จึงไม่มี JWT_SECRET — cookie เก็บค่าสุ่ม opaque ที่ชี้ไปยัง
# แถวใน iam.session (docs/09-auth-tokens.md §1) เพิกถอนได้ทีละใบ ไม่ต้องหมุนความลับทั้งระบบ
SESSION_TTL_DAYS=7
# ไม่ได้ใช้งานนานเท่านี้แล้ว session ตาย แม้ยังไม่ครบ SESSION_TTL_DAYS
SESSION_IDLE_HOURS=8
INVITATION_TTL_DAYS=7
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# server_secret ของ activation key — sheet `activation_key` กำหนดว่า
#   key_hash = HMAC-SHA-256(server_secret, raw_activation_key)
# ถ้าค่านี้เป็นค่าที่เดาได้ HMAC ก็ไม่ต่างจาก SHA-256 เปล่า ซึ่งเป็นเหตุผลเดียว
# ที่เปลี่ยนมาใช้ HMAC ตั้งแต่แรก · backend ปฏิเสธที่จะบูตบน production ถ้าไม่ได้ตั้ง
# สร้างด้วย: openssl rand -base64 48
ACTIVATION_KEY_SECRET=dev-only-change-me-activation-key-secret
ACTIVATION_KEY_TTL_DAYS=7

# สเปกระบุว่า API เชิญผู้ใช้ "ไม่มี UI" จึงป้องกันด้วย shared secret แทน session
# ใช้แบบนี้:  curl -H "x-admin-token: $ADMIN_API_TOKEN" ...
ADMIN_API_TOKEN=dev-admin-token-change-me

# URL ที่ใส่ในลิงก์ของอีเมล ต้องเป็น URL ที่ผู้รับเปิดได้จากเครื่องตัวเอง
APP_URL=http://localhost:3000

# ---------- Email (Gmail SMTP สำหรับทดสอบ) ----------
#
# ปล่อย SMTP_USER ว่างไว้ = ระบบจะพิมพ์เนื้ออีเมลและลิงก์/OTP ลง log ของ backend
# แทนการส่งจริง ทดสอบ flow ได้ครบโดยไม่ต้องตั้งค่าอะไรเลย
#     docker compose logs -f backend
#
# เมื่อต้องการส่งจริงผ่าน Gmail:
#   1. เปิด 2-Step Verification ที่ https://myaccount.google.com/security
#   2. สร้าง App Password ที่ https://myaccount.google.com/apppasswords
#      (เลือก Mail → Other → ตั้งชื่อ เช่น "BDI Datahub")
#   3. ใส่รหัส 16 หลักที่ได้ลงใน SMTP_PASS โดย**ลบช่องว่างออก**
#      รหัสผ่านบัญชี Google ปกติใช้ไม่ได้ ต้องเป็น App Password เท่านั้น
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BDI Datahub <no-reply@bdi.or.th>"

# ---------- ThaiD ----------
# การเปิดใช้งานบัญชีทุกครั้งต้องผ่าน ThaiD และเข้าสู่ระบบก็ใช้ ThaiD แทนรหัสผ่านได้
# ค่าจริงอยู่ใน assets/thaid/ (ไม่อยู่ใน git) — ห้ามคัดลอกลงไฟล์ที่ track ไว้
#
# sandbox ของกรมการปกครอง: https://imauthsbx.bora.dopa.go.th
# ทดสอบด้วย client ตัวอย่างของ sandbox ได้ ซึ่งรับ redirect_uri อะไรก็ได้และให้ scope
# ครบรวม pid ส่วน client ที่ลงทะเบียนไว้ในชื่อโครงการนี้ยัง **ไม่ได้รับ scope pid**
# และผูก redirect_uri ไว้กับ http://localhost:3000/auth/callback/thaid เท่านั้น
THAID_ROOT_URL=https://imauthsbx.bora.dopa.go.th
THAID_CLIENT_ID=
THAID_CLIENT_SECRET=
THAID_API_KEY=
# ต้องตรงตัวอักษรกับที่ลงทะเบียนไว้ ปล่อยว่าง = ${APP_URL}/auth/callback/thaid
THAID_REDIRECT_URI=
# ปล่อยว่างได้ ค่าตั้งต้นคือ openid pid given_name family_name given_name_en family_name_en
# **ไม่มี `title`** จึงไม่ได้คำนำหน้าชื่อจากบัตร ฟอร์มสร้างบัญชีเติมชื่อกับนามสกุลให้
# ส่วนคำนำหน้าผู้ใช้เลือกเอง
# client ของโครงการรับได้แค่ `openid` (หรือบวกชื่อ-นามสกุล) ขอ pid เมื่อไรได้ invalid_scope
THAID_SCOPE=
#
# เลขประจำตัวประชาชนที่เอาไปเทียบกับที่เจ้าหน้าที่บันทึกไว้ อ่านจาก claim ไหน
#   true  = claim `pid` ตามคู่มือ ต้องได้ scope `pid` มาด้วย
#   false = claim `sub` ซึ่ง sandbox ส่งเป็นเลขบัตร 13 หลักอยู่แล้ว
# ใช้ false กับ client ที่ยังไม่ได้รับ scope `pid` — การเทียบยังทำเหมือนเดิมทุกอย่าง
# ตัวแปรนี้เลือกแค่ที่มาของเลข ไม่ใช่สวิตช์ปิดการตรวจ
THAID_USE_PID=true

# ระบบส่ง `nonce` ไปกับ authorization request เสมอ และ nonce ที่ "ไม่ตรง" ถูกปฏิเสธเสมอ
# ค่านี้ตัดสินเฉพาะกรณีที่ id_token ไม่มี claim nonce กลับมาเลย
#   false (ค่าตั้งต้น) = เตือนใน log แล้วไปต่อ — ยังไม่ยืนยันว่ากรมการปกครองสะท้อน nonce กลับมา
#   true              = ปฏิเสธ ตั้งค่านี้เมื่อเห็นจากการยิงจริงแล้วว่ามีมา
THAID_REQUIRE_NONCE=false

# ---------- เปิดใช้งานจากภายนอก ----------
# เมื่อ expose ผ่าน Cloudflare Tunnel หรือ reverse proxy ให้ตั้งสามค่านี้ให้ตรงกัน
# ตัวอย่างที่ใช้จริงบนเครื่องนี้:
#   APP_URL=https://bdi.thammasorn.org          ← URL ที่ผู้ใช้เปิด (ใช้ในลิงก์อีเมลด้วย)
#   NEXT_PUBLIC_API_URL=https://bdi-api.thammasorn.org  ← URL ที่ "เบราว์เซอร์" เรียก API
#   CORS_ORIGIN=https://bdi.thammasorn.org      ← origin ที่อนุญาต (คั่นหลายค่าด้วย comma)
#
# COOKIE_SECURE ปล่อยว่างไว้ได้ ระบบจะเปิด Secure ให้อัตโนมัติเมื่อ APP_URL เป็น https
COOKIE_SECURE=
