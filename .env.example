# Copy to .env and adjust. `.env` is gitignored.
# docker compose reads this file automatically.

# ---------- Identity ----------
COMPOSE_PROJECT_NAME=bdi-main

# ---------- Postgres ----------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# ---------- Azure Blob Storage ----------
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=bdi-uploads
AZURITE_BLOB_PORT=10000

# ---------- Backend ----------
BACKEND_PORT=4000
NODE_ENV=development

# ---------- Frontend ----------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=

# ---------- Auth ----------
JWT_SECRET=
SESSION_TTL_DAYS=
INVITATION_TTL_DAYS=
OTP_TTL_MINUTES=
OTP_MAX_ATTEMPTS=
ADMIN_API_TOKEN=
APP_URL=
CORS_ORIGIN=

# ---------- Email (Gmail SMTP) ----------
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REPLY_TO=

# ---------- ThaiD ----------
THAID_ROOT_URL=
THAID_API_KEY=
THAID_CLIENT_ID=
THAID_CLIENT_SECRET=
THAID_REDIRECT_URI=
THAID_SCOPE=openid pid given_name family_name given_name_en family_name_en title title_en


# for testing
THAID_USE_PID=true

# server_secret ของ activation key — HMAC-SHA-256
ACTIVATION_KEY_SECRET=
ACTIVATION_KEY_TTL_DAYS=7