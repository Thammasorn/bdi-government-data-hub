# Copy to .env and adjust. `.env` is gitignored.
# docker compose reads this file automatically.

# ---------- Identity ----------
# Namespaces containers, networks and volumes. MUST be unique per checkout so
# several developers can run their stacks at the same time on one machine.
COMPOSE_PROJECT_NAME=bdi-main

# ---------- Ports ----------
# Every port must be unique per checkout too. Convention on the shared box:
#   main      3001 / 4000 / 5432 / 9000
#   dev_NN    31N0 / 41N0 / 55N0 / 91N0            (dev_01 -> 3110, 4110, ...)
# `new-dev.sh` fills these in automatically, AZURITE_BLOB_PORT included (แก้แล้วตอน merge
# 2026-09-07 — สคริปต์อยู่นอก repo ที่ /hdd1tb/bdi-project/new-dev.sh) checkout ที่สร้างก่อนหน้า
# นั้นยังมี MINIO_API_PORT / MINIO_CONSOLE_PORT ค้างอยู่ใน .env ซึ่งไม่มีอะไรอ่านแล้ว —
# ตั้ง AZURITE_BLOB_PORT เป็น 91N0 ของ slot ตัวเองด้วยมือ ปล่อยว่างไว้ทุก checkout จะแย่งกัน
# เปิดพอร์ต 10000 แล้วตัวที่สองขึ้นไม่ได้

# ---------- Postgres ----------
POSTGRES_USER=bdi
POSTGRES_PASSWORD=bdi_dev_password
POSTGRES_DB=bdi
POSTGRES_PORT=5432

# ---------- Azure Blob Storage ----------
# ไฟล์แนบทุกไฟล์อยู่ที่นี่ (เดิมเป็น MinIO — ย้ายตามการ์ด "Migrate to Azure")
#
# ในเครื่อง dev ปล่อยว่างไว้ได้ทั้งหมด: compose รันบริการ `azurite` ซึ่งเป็น emulator ของ
# Azure Storage และตั้ง connection string ของ emulator ให้เอง (account name/key ของ Azurite
# เป็นค่าคงที่สาธารณะที่ไมโครซอฟท์ประกาศไว้ ไม่ใช่ความลับ)
#
# ต่อกับ storage account จริง เลือกทางใดทางหนึ่ง:
#
#   AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
#       ไม่มีความลับใน .env เลย ตัวตนมาจาก DefaultAzureCredential — บน Azure คือ managed
#       identity ของ Container App/VM ที่รันอยู่ ต้องมี role "Storage Blob Data Contributor"
#       บน account หรือ container นั้น **นี่คือทางที่ควรใช้ตอนขึ้น production**
#
#   AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...
#       ถือ account key ไว้ในไฟล์ ใช้ตอนไล่ปัญหาในเครื่อง หรือที่ที่ยังไม่มี managed identity
#       ตั้งมาทั้งคู่ = ตัวนี้ชนะ
#
# ชื่อ container ต้องเป็นตัวพิมพ์เล็ก/ตัวเลข/ขีดกลาง ยาว 3–63 ตัวอักษร ตามกติกาของ Azure
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=bdi-uploads

# ตัวแปลง .docx -> PDF ของเอกสารกฎหมาย (บริการ gotenberg ใน compose)
# ปล่อยว่างไว้ได้ในเครื่อง dev — ค่าตั้งต้นชี้ไปที่บริการใน compose network
GOTENBERG_URL=
GOTENBERG_TIMEOUT_MS=
# พอร์ตที่ Azurite เปิดออกโฮสต์ (blob เท่านั้น — ไม่ได้ใช้ queue/table)
# Azurite ไม่มีหน้าคอนโซลแบบ MinIO จึงเหลือพอร์ตเดียว ดูของข้างในด้วย Azure Storage
# Explorer หรือ `az storage blob list --connection-string ...` แทน
AZURITE_BLOB_PORT=9000

# ---------- Backend ----------
BACKEND_PORT=4000
NODE_ENV=development

# ---------- Frontend ----------
FRONTEND_PORT=3000
# URL the browser uses to reach the backend (host network, not compose network).
# Must match BACKEND_PORT.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------- Auth ----------
# session ไม่ใช่ JWT แล้ว จึงไม่มี JWT_SECRET — cookie เก็บค่าสุ่ม opaque ที่ชี้ไปยัง
# แถวใน iam.session (docs/09-auth-tokens.md §1) เพิกถอนได้ทีละใบ ไม่ต้องหมุนความลับทั้งระบบ
SESSION_TTL_DAYS=7
# ไม่ได้ใช้งานนานเท่านี้แล้ว session ตาย แม้ยังไม่ครบ SESSION_TTL_DAYS
SESSION_IDLE_HOURS=8
INVITATION_TTL_DAYS=7
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# server_secret ของ activation key — sheet `activation_key` กำหนดว่า
#   key_hash = HMAC-SHA-256(server_secret, raw_activation_key)
# ถ้าค่านี้เป็นค่าที่เดาได้ HMAC ก็ไม่ต่างจาก SHA-256 เปล่า ซึ่งเป็นเหตุผลเดียว
# ที่เปลี่ยนมาใช้ HMAC ตั้งแต่แรก · backend ปฏิเสธที่จะบูตบน production ถ้าไม่ได้ตั้ง
# สร้างด้วย: openssl rand -base64 48
ACTIVATION_KEY_SECRET=dev-only-change-me-activation-key-secret
ACTIVATION_KEY_TTL_DAYS=7
# ลิงก์ตั้งรหัสผ่านใหม่ที่ผู้ดูแลระบบสั่งออกให้ (POST /api/admin/users/password-reset)
# hash ด้วย ACTIVATION_KEY_SECRET ตัวเดียวกัน อายุเป็นนาที — กดไม่ทันให้แอดมินสั่งใหม่
PASSWORD_RESET_TTL_MINUTES=60

# สเปกระบุว่า API เชิญผู้ใช้ "ไม่มี UI" จึงป้องกันด้วย shared secret แทน session
# ใช้แบบนี้:  curl -H "x-admin-token: $ADMIN_API_TOKEN" ...
ADMIN_API_TOKEN=dev-admin-token-change-me
# fingerprint ของ token ข้างบนตัวที่ปลดไปแล้ว (12 ตัวแรกของ SHA-256) คั่นด้วย comma — ว่างได้
# ใครยังยิงด้วยค่าเก่าจะได้แถว ADMIN_TOKEN_REJECTED ของตัวเอง (watched_token, ไม่เกิน 60 แถว/10 นาที) ไม่จมหายในแถวสรุป
# ใส่ fingerprint เท่านั้น ห้ามใส่ตัว token — วิธีคำนวณอยู่ใน docs/09-auth-tokens.md §4.1
ADMIN_TOKEN_WATCH_FPS=

# URL ที่ใส่ในลิงก์ของอีเมล ต้องเป็น URL ที่ผู้รับเปิดได้จากเครื่องตัวเอง
APP_URL=http://localhost:3000

# ---------- Email (Gmail SMTP สำหรับทดสอบ) ----------
#
# ปล่อย SMTP_USER ว่างไว้ = ระบบจะพิมพ์เนื้ออีเมลและลิงก์/OTP ลง log ของ backend
# แทนการส่งจริง ทดสอบ flow ได้ครบโดยไม่ต้องตั้งค่าอะไรเลย
#     docker compose logs -f backend
#
# เมื่อต้องการส่งจริงผ่าน Gmail:
#   1. เปิด 2-Step Verification ที่ https://myaccount.google.com/security
#   2. สร้าง App Password ที่ https://myaccount.google.com/apppasswords
#      (เลือก Mail → Other → ตั้งชื่อ เช่น "D2")
#   3. ใส่รหัส 16 หลักที่ได้ลงใน SMTP_PASS โดย**ลบช่องว่างออก**
#      รหัสผ่านบัญชี Google ปกติใช้ไม่ได้ ต้องเป็น App Password เท่านั้น
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ระบบกลางเพื่อการแบ่งปันข้อมูลดิจิทัล <no-reply@bdi.or.th>"
# ที่อยู่ที่ผู้รับได้เมื่อกด reply — **ไม่ตั้ง = ไม่มีหัวข้อ Reply-To ในอีเมลเลย**
# ของจริงต้องตั้ง เพราะกล่องที่ระบบใช้ส่ง (SMTP_USER) ไม่มีคนอ่าน และ Exchange/Outlook
# เขียน From ทับด้วยบัญชีที่ล็อกอินเมื่อบัญชีนั้นไม่มีสิทธิ์ send-as คนกด reply จึงได้กล่องส่ง
# ตั้งให้ตรงกับ SUPPORT_EMAIL ข้างล่าง ไม่งั้นบรรทัดติดต่อท้ายอีเมลกับที่อยู่รับคำตอบจะขัดกัน
SMTP_REPLY_TO=d2share-support@bdi.or.th

# ---------- ช่องทางติดต่อท้ายอีเมล ----------
# อีเมลทุกฉบับปิดท้ายด้วย "หากมีข้อสงสัยหรือประสบปัญหาในการดำเนินการ สามารถติดต่อ …"
# ค่าด้านล่างคือค่าตั้งต้นที่ระบบใช้อยู่แล้ว ใส่ไว้ให้เห็นว่าแก้ที่ไหนได้ ไม่ใช่ว่าต้องตั้ง —
# แก้แล้วรีสตาร์ต backend กับ delivery-worker ก็ขึ้นทันที ไม่ต้อง build ใหม่
SUPPORT_EMAIL=d2share-support@bdi.or.th
SUPPORT_PHONE=02-480-8833

# ---------- ThaID ----------
# การเปิดใช้งานบัญชีทุกครั้งต้องผ่าน ThaID และเข้าสู่ระบบก็ใช้ ThaID แทนรหัสผ่านได้
# ค่าจริงอยู่ใน assets/thaid/ (ไม่อยู่ใน git) — ห้ามคัดลอกลงไฟล์ที่ track ไว้
#
# sandbox ของกรมการปกครอง: https://imauthsbx.bora.dopa.go.th
# ทดสอบด้วย client ตัวอย่างของ sandbox ได้ ซึ่งรับ redirect_uri อะไรก็ได้และให้ scope
# ครบรวม pid ส่วน client ที่ลงทะเบียนไว้ในชื่อโครงการนี้ยัง **ไม่ได้รับ scope pid**
# และผูก redirect_uri ไว้กับ http://localhost:3000/auth/callback/thaid เท่านั้น
THAID_ROOT_URL=https://imauthsbx.bora.dopa.go.th
THAID_CLIENT_ID=
THAID_CLIENT_SECRET=
THAID_API_KEY=
# ต้องตรงตัวอักษรกับที่ลงทะเบียนไว้ ปล่อยว่าง = ${APP_URL}/auth/callback/thaid
THAID_REDIRECT_URI=
# ปล่อยว่างได้ ค่าตั้งต้นคือ openid pid given_name family_name given_name_en family_name_en
# **ไม่มี `title`** จึงไม่ได้คำนำหน้าชื่อจากบัตร ฟอร์มสร้างบัญชีเติมชื่อกับนามสกุลให้
# ส่วนคำนำหน้าผู้ใช้เลือกเอง
# client ของโครงการรับได้แค่ `openid` (หรือบวกชื่อ-นามสกุล) ขอ pid เมื่อไรได้ invalid_scope
THAID_SCOPE=
#
# เลขประจำตัวประชาชนที่เอาไปเทียบกับที่เจ้าหน้าที่บันทึกไว้ อ่านจาก claim ไหน
#   true  = claim `pid` ตามคู่มือ ต้องได้ scope `pid` มาด้วย
#   false = claim `sub` ซึ่ง sandbox ส่งเป็นเลขบัตร 13 หลักอยู่แล้ว
# ใช้ false กับ client ที่ยังไม่ได้รับ scope `pid` — การเทียบยังทำเหมือนเดิมทุกอย่าง
# ตัวแปรนี้เลือกแค่ที่มาของเลข ไม่ใช่สวิตช์ปิดการตรวจ
THAID_USE_PID=true

# ระบบส่ง `nonce` ไปกับ authorization request เสมอ และ nonce ที่ "ไม่ตรง" ถูกปฏิเสธเสมอ
# ค่านี้ตัดสินเฉพาะกรณีที่ id_token ไม่มี claim nonce กลับมาเลย
#   false (ค่าตั้งต้น) = เตือนใน log แล้วไปต่อ — ยังไม่ยืนยันว่ากรมการปกครองสะท้อน nonce กลับมา
#   true              = ปฏิเสธ ตั้งค่านี้เมื่อเห็นจากการยิงจริงแล้วว่ามีมา
THAID_REQUIRE_NONCE=false

# ---------- Log store (MongoDB) ----------
# สำเนาค้นหาได้ของ audit.audit_event และที่เก็บ error ของระบบ — บริการ `mongo` ใน compose ไม่เปิดพอร์ตออกโฮสต์
# ดูข้างในด้วยรหัสผ่านที่อยู่ใน container อยู่แล้ว (ไม่พิมพ์รหัสผ่านลง command line ของเครื่อง ซึ่ง `ps` และ history เห็น):
#   docker compose exec mongo sh -c 'mongosh -u "$MONGO_INITDB_ROOT_USERNAME" -p "$MONGO_INITDB_ROOT_PASSWORD" --authenticationDatabase admin "$MONGODB_DB"'
#
# เป็นของเสริม: mongo ล่มหรือปิดอยู่ เว็บยังทำงานครบ /health/ready ยังตอบ 200 (แค่ checks.logStore บอกสถานะ)
# สวิตช์ปิดคือ LOG_STORE_ENABLED=false แล้วสร้าง backend กับ delivery-worker ใหม่ — ปิดแล้วไม่โหลด driver ของ Mongo เลย
# ว่าง = true ส่วนการเว้น URI ให้ว่างปิดไม่ได้ เพราะ `:-` ใน compose เติม URI ตั้งต้นกลับมาให้
LOG_STORE_ENABLED=
#
# รหัสผ่านสามตัวนี้ใช้**ครั้งเดียว ตอน volume mongo-data ยังว่าง** — แก้ทีหลังไม่มีผลกับ volume เดิม
# (เปลี่ยนของ bdi_backend/bdi_worker ด้วยการรัน mongo/init/01-users.js ซ้ำ ดูหัวไฟล์นั้น)
# ค่าข้างล่างเป็นค่าตัวอย่างสาธารณะสำหรับเครื่อง dev เท่านั้น — docker-compose.prod.yml สั่งให้ mongo **ไม่ยอมเริ่ม**
# ถ้ายังเป็น dev-…/…change-me หรือว่าง ของจริงต้องตั้งก่อน deploy ครั้งแรกที่มี mongo ด้วย `openssl rand -hex 32`
# (ฐานสิบหกเพราะรหัสผ่านของ backend/worker ถูกแทนลง URI ตรง ๆ โดยไม่ encode)
MONGO_ROOT_USER=bdi
MONGO_ROOT_PASSWORD=dev-mongo-root-change-me
# bdi_backend — อ่านได้ เพิ่มได้เฉพาะ collection ที่มันเขียน (ไม่รวม relay_state) ลบหรือแก้ activity ไม่ได้
# (process ที่รับคำขอจากอินเทอร์เน็ต — รายการเต็มใน mongo/init/01-users.js)
MONGO_BACKEND_PASSWORD=dev-mongo-backend-change-me
# bdi_worker — ลบได้ สำหรับ prune ตามอายุ และสร้าง index
MONGO_WORKER_PASSWORD=dev-mongo-worker-change-me
#
# ชี้ไป Mongo ตัวอื่นแทนบริการใน compose (managed Mongo) — ทับ URI ที่ compose ประกอบจากรหัสผ่านข้างบน
# อักขระพิเศษในรหัสผ่านต้อง percent-encode (@ เป็น %40, / เป็น %2F, ช่องว่างเป็น %20) ไม่อย่างนั้น driver แยก
# URI ผิดแล้ว log store ขึ้น down โดย log บอกแค่ว่า URI ใช้ไม่ได้ — ไม่ยกข้อความของ driver เพราะมันมีรหัสผ่านปน
# MONGODB_BACKEND_URI=mongodb+srv://...
# MONGODB_WORKER_URI=mongodb+srv://...
# ว่าง = bdi_logs
MONGODB_DB=
# เพดานขนาด (MB ที่ข้อมูลกับ index ใช้อยู่จริง ไม่นับพื้นที่ว่างที่ Mongo จองไว้ใช้ซ้ำ — ขนาดบนดิสก์จึงเกินค่านี้ได้จนกว่าจะ
# compact) — ว่าง = 5120 บน production, 512 ที่อื่น · worker ตรวจตอนบูตและทุกชั่วโมง
# เกินแล้ว error เก็บแค่ตัวนับของ issue จนกว่าจะต่ำกว่า 90% (บรรทัด `[log-store] … เกินเพดาน` ใน log ของ worker)
# LOG_STORE_MAX_MB=
# กุญแจ HMAC ของ key ค้นหาในสำเนากิจกรรม (`cid#…` / `email#…`) — ทำให้ค้นด้วยเลขบัตรหรืออีเมลได้โดยไม่เก็บค่าจริง
# ว่าง = ค่าตัวอย่างของ dev · production ต้องตั้งเป็น `openssl rand -hex 32` ไม่งั้นไม่มี key ค้นหา (มีบรรทัดเตือนตอนบูต)
# เปลี่ยนค่าหลังจากสำเนามีข้อมูลแล้วต้อง rebuild สำเนา (docs/21) — key เดิมหาด้วยกุญแจใหม่ไม่เจอ
LOG_HASH_KEY=
# token ของ API อ่าน log (`x-log-token` ของ /api/admin/logs/* — Postman docs/bdi-activity-log.postman_collection.json)
# แยกจาก ADMIN_API_TOKEN โดยตั้งใจ: คนถือ admin token ไม่ได้สิทธิ์อ่าน log ไปด้วย ทุกการอ่านถูกบันทึกเป็น AUDIT_LOG_READ
# ค่าข้างล่างเป็นค่าตัวอย่างสาธารณะของเครื่อง dev (ตรงกับ Postman environment ของ dev checkout) — **production ไม่รับค่านี้**:
# ค่าตัวอย่างหรือสั้นกว่า 32 ตัวถือเป็นไม่ได้ตั้ง API อ่าน log ตอบ 503 log_access_disabled ของจริงคือ `openssl rand -hex 32`
LOG_READ_TOKEN=dev-log-token-change-me
# ความลับที่ Next server แนบกับรายงาน error ของตัวเอง (POST /api/client-errors — x-report-token) ค่าเดียวกันทั้ง backend และ
# frontend ตรงแล้ว backend เก็บรายงานนั้นเป็น frontend-server ไม่ตรงหรือไม่มีเก็บเป็น browser ที่ยืนยันไม่ได้ (ไม่กระทบอย่างอื่น)
# ว่าง = ค่าตัวอย่างของ dev · production ไม่รับค่าตัวอย่างหรือค่าที่สั้นกว่า 32 ตัว — ของจริงคือ `openssl rand -hex 32`
INGEST_SERVER_TOKEN=
# ผู้รับอีเมลสรุปปัญหาของระบบ คั่นด้วย comma (delivery-worker ส่งเอง — workers/error-alerts.ts) ว่าง = ไม่แจ้งเตือน issue
# ยังถูกเก็บตามปกติ · สรุปฉบับใหม่ไม่เกินหนึ่งฉบับต่อ 15 นาที (ผู้รับที่ยังค้างฉบับก่อนได้ฉบับนั้นซ้ำได้อีกหนึ่ง — ไม่เกินสองอีเมล
# ต่อผู้รับใน 15 นาทีใด ๆ) ปัญหาเดียวกันไม่เกินทุก 6 ชั่วโมง เว้นแต่เกิดซ้ำหลังปิด
# SMTP ยังไม่ได้ตั้ง = สรุปถูกพิมพ์ลง `docker compose logs delivery-worker` แทน
# ERROR_ALERT_EMAILS=dev-team@example.com,sysadmin@example.com
# ชื่อ deployment ที่ติดไปกับทุก error event — ว่าง = COMPOSE_PROJECT_NAME ข้างบน
# DEPLOY_ENV=
# รุ่นของโค้ด (RELEASE) ไม่ได้ตั้งที่นี่: ส่ง GIT_SHA ตอน build image ของ production แล้ว image ฝังไว้เอง
#   TMPDIR=/hdd1tb/tmp GIT_SHA="$(git rev-parse --short HEAD)" docker compose -f docker-compose.yml -f docker-compose.prod.yml build

# ---------- เปิดใช้งานจากภายนอก ----------
# เมื่อ expose ผ่าน Cloudflare Tunnel หรือ reverse proxy ให้ตั้งสามค่านี้ให้ตรงกัน
# ตัวอย่างที่ใช้จริงบนเครื่องนี้:
#   APP_URL=https://bdi.thammasorn.org          ← URL ที่ผู้ใช้เปิด (ใช้ในลิงก์อีเมลด้วย)
#   NEXT_PUBLIC_API_URL=https://bdi-api.thammasorn.org  ← URL ที่ "เบราว์เซอร์" เรียก API
#   CORS_ORIGIN=https://bdi.thammasorn.org      ← origin ที่อนุญาต (คั่นหลายค่าด้วย comma)
#
# COOKIE_SECURE ปล่อยว่างไว้ได้ ระบบจะเปิด Secure ให้อัตโนมัติเมื่อ APP_URL เป็น https
COOKIE_SECURE=
