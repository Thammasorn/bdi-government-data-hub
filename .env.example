# Copy to .env and adjust. `.env` is gitignored.
# docker compose reads this file automatically.

# ---------- Postgres ----------
POSTGRES_USER=bdi
POSTGRES_PASSWORD=bdi_dev_password
POSTGRES_DB=bdi
POSTGRES_PORT=5432

# ---------- MinIO ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=bdi-uploads
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- Backend ----------
BACKEND_PORT=4000
NODE_ENV=development

# ---------- Frontend ----------
FRONTEND_PORT=3000
# URL the browser uses to reach the backend (host network, not compose network)
NEXT_PUBLIC_API_URL=http://localhost:4000
