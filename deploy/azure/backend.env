# backend — Azure Container Apps
#
# targetPort 4000 · ingress: external (โดเมน bdi-api.thammasorn.org ชี้มาที่นี่)
# image: gbdi/d2s-portal-backend
# command: sh -c "npx prisma migrate deploy && node dist/index.js"
#
# ค่าที่เว้นว่างไว้คือความลับ — ตั้งเป็น secret ของ Container App แล้วอ้างด้วย secretref
# ห้ามใส่ค่าจริงลงไฟล์นี้ ไฟล์นี้ไม่ได้อยู่ใน .gitignore
#
# env.ts จะโยน error ตั้งแต่ตอนบูตถ้าตัวที่ทำเครื่องหมาย [ต้องมี] ขาดไป

NODE_ENV=production
PORT=4000

# ---------- ที่อยู่สาธารณะ ----------
# ใช้สร้างลิงก์ในอีเมล และเป็นตัวตัดสินว่า session cookie ตั้ง Secure ไหม
# (env.ts เปิด Secure ให้เองเมื่อค่านี้ขึ้นต้นด้วย https จึงไม่ต้องตั้ง COOKIE_SECURE)
APP_URL=https://bdi.thammasorn.org
# รับหลาย origin ได้ คั่นด้วย comma
CORS_ORIGIN=https://bdi.thammasorn.org

# ---------- ฐานข้อมูล [ต้องมี] ----------
# Azure Database for PostgreSQL flexible server บังคับ TLS — ต้องมี sslmode=require
# DATABASE_URL=postgresql://USER:PASS@HOST.postgres.database.azure.com:5432/bdi?schema=public&sslmode=require
DATABASE_URL=

# ---------- Object storage (Azure Blob) ----------
# ตั้งอย่างน้อยหนึ่งในสองทาง ไม่งั้น env.ts โยน error ตั้งแต่บูต
#
# ทางที่ควรใช้บน ACA — managed identity ผ่าน DefaultAzureCredential
# ไม่มีความลับใน env เลย เพิกถอนสิทธิ์ได้จาก Azure และไม่ต้องหมุน key
# ต้องเปิด system-assigned identity ให้ container app แล้วให้ role
# "Storage Blob Data Contributor" บน storage account ตัวนั้น
AZURE_STORAGE_ACCOUNT_URL=https://bdidatahub.blob.core.windows.net
# ทางสำรอง — connection string (มี account key อยู่ข้างใน ต้องเป็น ACA secret)
# ตั้งมาทั้งคู่ = connection string ชนะ
AZURE_STORAGE_CONNECTION_STRING=
# ชื่อ container ต้องเป็นตัวพิมพ์เล็ก ตัวเลข ขีดกลาง ยาว 3-63 ตัวตามกติกาของ Azure
AZURE_STORAGE_CONTAINER=bdi-uploads

# ---------- ตัวแปลง .docx เป็น PDF ----------
# ACA internal ingress ปิด TLS ให้ที่ 443 จึงเป็น https และไม่ต้องระบุพอร์ต
# ชื่อเต็มดูจาก: az containerapp show -n gotenberg --query properties.configuration.ingress.fqdn
GOTENBERG_URL=https://gotenberg.internal.<env>.<region>.azurecontainerapps.io
# ค่านี้คือเวลาที่ backend ยอมรอ — ต้องไม่มากกว่า --api-timeout ของ gotenberg
GOTENBERG_TIMEOUT_MS=60000

# ---------- อีเมล ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ระบบกลางเพื่อการแบ่งปันข้อมูลดิจิทัล <no-reply@bdi.or.th>

# ---------- ข้อมูลติดต่อที่ขึ้นท้ายอีเมล ----------
# ไม่ตั้ง SUPPORT_PHONE = เนื้ออีเมลจะไม่มีบรรทัดเบอร์โทร (ดีกว่าส่ง [หมายเลขโทรศัพท์] ออกไป)
SUPPORT_EMAIL=d2share-support@bdi.or.th
SUPPORT_PHONE=

# ---------- Auth ----------
# ไม่มี JWT_SECRET — session เป็นค่าสุ่ม opaque ที่ชี้ไปยังแถวใน iam.session
ADMIN_API_TOKEN=
# fingerprint ของ ADMIN_API_TOKEN ตัวที่ปลดแล้ว คั่นด้วย comma ว่างได้ (docs/09-auth-tokens.md §4.1)
ADMIN_TOKEN_WATCH_FPS=
# [ต้องมีบน production] key_hash = HMAC-SHA-256(ค่านี้, raw_activation_key)
# สร้างด้วย: openssl rand -base64 48
ACTIVATION_KEY_SECRET=
ACTIVATION_KEY_TTL_DAYS=7
SESSION_TTL_DAYS=7
SESSION_IDLE_HOURS=8
INVITATION_TTL_DAYS=7
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ---------- ThaiD (DOPA IdP) ----------
# redirect_uri ต้องตรงตัวอักษรกับที่ลงทะเบียนไว้กับกรมการปกครอง
THAID_ROOT_URL=https://imauthsbx.bora.dopa.go.th
THAID_CLIENT_ID=
THAID_CLIENT_SECRET=
THAID_API_KEY=
THAID_REDIRECT_URI=https://bdi.thammasorn.org/auth/callback/thaid
THAID_SCOPE=openid pid given_name family_name given_name_en family_name_en
THAID_USE_PID=true
THAID_REQUIRE_NONCE=false
THAID_STATE_TTL_MINUTES=15
THAID_VERIFICATION_TTL_MINUTES=30

# ---------- Log store (MongoDB) ----------
# **ปิดไว้จนกว่า BDI เลือกบริการ Mongo บน Azure** (Cosmos DB for MongoDB vCore หรือ Atlas — ไม่ใช่ Cosmos RU และ
# ห้ามรัน mongo เป็น container app เพราะ Azure Files ใช้เป็นที่เก็บข้อมูลของ mongod ไม่ได้) ระหว่างนี้ stdout ของ
# container ไปถึง Log Analytics อยู่แล้ว · ปิดอยู่ = ไม่โหลด driver เลย /health/ready แสดง logStore: disabled
# ไม่มีผลกับ healthy และ probe ของ ACA ใช้ /health/live อยู่แล้ว
LOG_STORE_ENABLED=false
# [ความลับ] secretref:mongodb-backend-uri — user ของ backend ต้องลบหรือแก้ activity ไม่ได้ (ดู mongo/init/01-users.js)
MONGODB_URI=
MONGODB_DB=bdi_logs
# ชื่อ deployment ที่ติดไปกับทุก error event (stdout ด้วย) — แยกของ Azure ออกจากเครื่อง compose
# รุ่นของโค้ด (RELEASE) มาจาก build arg GIT_SHA ตอน build image ไม่ใช่ตัวแปรในไฟล์นี้ — ตั้งตรงนี้จะทับค่าที่ฝังใน image
DEPLOY_ENV=azure
