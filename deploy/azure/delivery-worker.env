# delivery-worker — Azure Container Apps
#
# ไม่มี ingress (ไม่รับ request จากใคร) · ไม่ต้องเปิดพอร์ต
# image: gbdi/d2s-delivery-worker  ← repo ของตัวเอง แต่เนื้อ image เดียวกับ d2s-portal-backend
#                                    ทุกไบต์ (digest ตรงกัน) ต่างกันแค่ command
# command: node dist/workers/delivery.js
#          ต้องสั่งเอง — CMD ที่ติดมากับ image คือ node dist/index.js ซึ่งจะเปิด API แทน
#
# ตั้ง minReplicas=1 และ maxReplicas=1 — ตัวนี้เป็นลูป poll ไม่ใช่ HTTP service
# ถ้าปล่อยให้ scale to zero ตาม default ของ ACA อีเมลจะไม่ถูกส่งจนกว่าจะมีอะไรปลุก
# (โค้ดใช้ FOR UPDATE SKIP LOCKED จึงรันหลายตัวพร้อมกันได้โดยไม่ส่งซ้ำ แต่ไม่มีเหตุให้ทำ)

NODE_ENV=production

# ---------- ฐานข้อมูล [ต้องมี] ----------
# คิวอยู่ในตาราง notification.notification_delivery — ชี้ไปฐานข้อมูลเดียวกับ backend
DATABASE_URL=

# ---------- ที่อยู่สาธารณะ ----------
# ใช้ประกอบลิงก์ในเนื้ออีเมล ต้องเป็น URL ที่ผู้รับเปิดจากเครื่องตัวเองได้
APP_URL=https://bdi.thammasorn.org

# ---------- อีเมล ----------
# ไม่ตั้ง SMTP_USER = พิมพ์อีเมลลง log แทนการส่งจริง (พฤติกรรมของ lib/mail.ts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ระบบกลางเพื่อการแบ่งปันข้อมูลดิจิทัล <no-reply@bdi.or.th>
# Exchange เขียนทับ SMTP_FROM ด้วยบัญชีที่ล็อกอิน แต่ไม่แตะ Reply-To
# ตั้งให้ตรงกับ SUPPORT_EMAIL เสมอ ปล่อยว่าง = ไม่ใส่หัวจดหมายนี้เลย
SMTP_REPLY_TO=d2share-support@bdi.or.th
# ต่อท้ายเนื้ออีเมล — ไม่ตั้ง SUPPORT_PHONE = ไม่มีบรรทัดเบอร์โทร ดีกว่าส่ง [หมายเลขโทรศัพท์] ออกไป
SUPPORT_EMAIL=d2share-support@bdi.or.th
SUPPORT_PHONE=

# ---------- จังหวะการทำงาน ----------
DELIVERY_POLL_INTERVAL_MS=15000
# ครบจำนวนนี้แล้วยังส่งไม่ได้ แถวจะกลายเป็น DEAD_LETTER
# retry ถอยหลังแบบ 2, 4, 8, 16 นาที
DELIVERY_MAX_ATTEMPTS=5

# ---------- Log store (MongoDB) ----------
# ปิดไว้จนกว่า BDI เลือกบริการ Mongo บน Azure — เหตุผลเต็มอยู่ใน backend.env · ปิดอยู่ = ไม่โหลด driver เลย
# ลูปส่งอีเมลไม่ขึ้นกับ log store ไม่ว่าเปิดหรือปิด
LOG_STORE_ENABLED=false
# [ความลับ] secretref:mongodb-worker-uri — user ของ worker (ลบได้ สำหรับ prune ตามอายุ) ไม่ใช่ตัวเดียวกับ backend
MONGODB_URI=
MONGODB_DB=bdi_logs
# [ความลับ] secretref:log-hash-key — secret ตัวเดียวกับของ backend
LOG_HASH_KEY=
# ผู้รับอีเมลสรุป error คั่นด้วย comma (workers/error-alerts.ts) — ว่าง = ไม่แจ้งเตือน · ไม่มีผลขณะ LOG_STORE_ENABLED=false
ERROR_ALERT_EMAILS=
# ชื่อ deployment ที่ติดไปกับทุก error event (stdout ด้วย) — แยกของ Azure ออกจากเครื่อง compose
# รุ่นของโค้ด (RELEASE) มาจาก build arg GIT_SHA ตอน build image ไม่ใช่ตัวแปรในไฟล์นี้ — ตั้งตรงนี้จะทับค่าที่ฝังใน image
DEPLOY_ENV=azure

# ---------- ตัวที่ worker ไม่ได้ใช้ แต่ขาดไม่ได้ ----------
# workers/render.ts -> lib/mail.ts -> env.ts และ env.ts ประกอบ object ทั้งก้อนตอน import
# แล้วเช็คท้ายไฟล์ว่ามีทางต่อ Azure Blob อย่างน้อยหนึ่งทาง — ไม่มีแล้วคอนเทนเนอร์ crash
# ตั้งแต่บูต ทั้งที่ worker ไม่เคยแตะ object storage และไม่มี HTTP endpoint ให้เรียก
# (ของเดิมเป็น MINIO_ROOT_USER/MINIO_ROOT_PASSWORD ที่บังคับด้วย required() แบบเดียวกัน)
#
# ตั้ง ACCOUNT_URL ให้เหมือน backend ก็พอ ไม่ต้องมอบ role ให้ identity ของ worker เลย —
# `DefaultAzureCredential` ไม่ได้คุยกับ Azure ตอนสร้างไคลเอนต์ มันไปหา credential ตอน
# เรียกใช้ครั้งแรก ซึ่ง worker ไม่มีวันเรียก
ADMIN_API_TOKEN=
AZURE_STORAGE_ACCOUNT_URL=https://bdidatahub.blob.core.windows.net
# [ต้องมีบน production] เพราะ NODE_ENV=production ทำให้ requiredInProduction() บังคับ
ACTIVATION_KEY_SECRET=
